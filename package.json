{
  "name": "odd-reveal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Odd Card: a word game for 4–12 players. Pass one phone around, or play on everyone’s own phone.",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test test/*.test.js",
    "deploy": "wrangler deploy",
    "e2e": "node test/e2e/multi-phone.e2e.mjs",
    "test:quick": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/multi-phone.e2e.mjs",
    "check": "node scripts/guard.mjs",
    "fuzz": "node scripts/sim-games.mjs 300"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "wrangler": "^4.151.2"
  }
}
